{% comment %}
  Project card + pop-up. Fields from the project's front matter:
    title, description (one line on the card), img,
    links: [{label, url}]  -> shown on the card AND in the pop-up
    videos: [path or YouTube embed url] -> played inside the pop-up
  The project's body text is the short pop-up description.
{% endcomment %}
{% assign modal_id = project.slug | prepend: 'project-' %}
{% capture links_html %}
  {% if project.links %}
    <div class="project-links">
      {% for l in project.links %}
        <a href="{{ l.url }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ l.label }}</a>
        {%- unless forloop.last %} <span class="project-links-sep">·</span>{% endunless %}
      {% endfor %}
    </div>
  {% endif %}
{% endcapture %}
<div class="col">
  <div
    class="card h-100 hoverable project-card"
    data-toggle="modal"
    data-target="#{{ modal_id }}"
    role="button"
    tabindex="0"
    aria-label="Open details for {{ project.title }}"
  >
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{{ project.title }}</h2>
      <p class="card-text">{{ project.description }}</p>
      {{ links_html }}
    </div>
  </div>

  <div class="modal fade project-modal" id="{{ modal_id }}" tabindex="-1" role="dialog" aria-labelledby="{{ modal_id }}-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="{{ modal_id }}-title">{{ project.title }}</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          {% if project.videos %}
            {% for v in project.videos %}
              {% if v contains 'youtube' %}
                <div class="embed-responsive embed-responsive-16by9 rounded mb-3">
                  <iframe class="embed-responsive-item" src="{{ v }}" loading="lazy" allowfullscreen></iframe>
                </div>
              {% else %}
                <video src="{{ v | relative_url }}" controls preload="metadata" class="w-100 rounded mb-3"></video>
              {% endif %}
            {% endfor %}
          {% elsif project.img %}
            <img src="{{ project.img | relative_url }}" alt="{{ project.title }}" class="img-fluid rounded mb-3" loading="lazy">
          {% endif %}
          {{ project.content | markdownify }}
          {{ links_html }}
        </div>
      </div>
    </div>
  </div>
</div>
