<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_step = site.announcements.limit | default: news_size %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% for item in news %}
          <tr {% if include.limit and forloop.index > news_step %}hidden{% endif %}>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit and news_size > news_step %}
      <div class="news-toggle">
        <button type="button" id="news-more">show more</button>
        <span id="news-sep" hidden>/</span>
        <button type="button" id="news-less" hidden>show less</button>
      </div>
      <script>
        (() => {
          const rows = [...document.querySelectorAll('.news tr')];
          const step = {{ news_step }};
          const more = document.getElementById('news-more');
          const less = document.getElementById('news-less');
          let shown = step;
          const render = () => {
            rows.forEach((r, i) => (r.hidden = i >= shown));
            more.hidden = shown >= rows.length;
            less.hidden = shown <= step;
            document.getElementById('news-sep').hidden = more.hidden || less.hidden;
          };
          more.onclick = () => { shown += step; render(); };
          less.onclick = () => { shown = Math.max(step, shown - step); render(); };
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
